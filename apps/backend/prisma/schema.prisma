// Prisma Schema for Saark Exploration ERP System
// Dual Compatibility: Currently SQLite, easily migratable to PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. AUTHENTICATION & ACCESS CONTROL (RBAC / PBAC)
// -------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  designation  String?
  departmentId String?
  status                  String     @default("ACTIVE") // ACTIVE, INACTIVE, LOCKED
  faceVerificationEnabled Boolean    @default(false)
  faceVerificationStatus  String     @default("NOT_ENROLLED") // NOT_ENROLLED, ENROLLED, LOCKED, DISABLED
  faceEnrolledAt          DateTime?
  failedFaceAttempts      Int        @default(0)
  faceLockoutUntil        DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  department              Department? @relation(fields: [departmentId], references: [id])
  userRoles               UserRole[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  staff                   Staff?
  employee                Employee?
  faceBiometric           EmployeeFaceBiometric?
  createdCustomers        Customer[] @relation("CustomerCreator")
  updatedCustomers        Customer[] @relation("CustomerUpdater")
  createdVendors          Vendor[]   @relation("VendorCreator")
  updatedVendors          Vendor[]   @relation("VendorUpdater")
  sessions                UserSession[]

  @@map("users")
  @@index([status])
  @@index([departmentId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  module      String   // CUSTOMERS, SALES, PURCHASE, INVENTORY, etc.
  action      String   // VIEW, CREATE, EDIT, DELETE, APPROVE, EXPORT
  description String?

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// -------------------------------------------------------------
// 2. ADMINISTRATION MASTERS
// -------------------------------------------------------------

model Company {
  id          String   @id @default(uuid())
  name        String
  legalName   String
  gstin       String
  pan         String
  cin         String?
  email       String
  phone       String
  website     String?
  address     String
  city        String
  state       String
  country     String   @default("India")
  pincode     String
  logoUrl     String?
  bankName    String?
  accountNo   String?
  ifscCode    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("companies")
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  headStaffId String? @unique
  users     User[]
  staff     Staff[]
  tasks     Task[]
  employees Employee[]
  headStaff Staff?   @relation("DepartmentHead", fields: [headStaffId], references: [id], onDelete: SetNull)
  teams     Team[]   @relation("PrimaryTeamDepartment")
  teamDepartments TeamDepartment[]
  createdAt DateTime @default(now())

  @@map("departments")
}

model Designation {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  staff       Staff[]
  createdAt   DateTime @default(now())

  @@map("designations")
}

model FinancialYear {
  id        String   @id @default(uuid())
  name      String   @unique // 2025-26, 2026-27
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  @@map("financial_years")
}

model TaxRate {
  id         String  @id @default(uuid())
  name       String  // GST 18%, GST 12%, GST 5%, GST 0%
  percentage Float
  cgst       Float
  sgst       Float
  igst       Float

  products   Product[]

  @@map("tax_rates")
}

model PaymentMode {
  id        String   @id @default(uuid())
  name      String   @unique // Cash, NEFT/RTGS, UPI, Cheque, Credit Card
  code      String   @unique
  createdAt DateTime @default(now())

  @@map("payment_modes")
}

// -------------------------------------------------------------
// 3. CUSTOMER MASTER & CONTACTS & VALUATION
// -------------------------------------------------------------

model Customer {
  id                   String   @id @default(uuid())
  customerCode         String   @unique // CUS-2026-00001
  companyName          String
  legalName            String?
  gstin                String?
  pan                  String?
  customerType         String   @default("END_CUSTOMER") // DEALER, DISTRIBUTOR, END_CUSTOMER, OEM, GOVT, PROSPECT, PARTNER
  customerCategory     String   @default("STANDARD")
  customerSegment      String?  @default("VFD_PANEL") // VFD_PANEL, DEWATERING, BOOSTER_PUMP, STP, BMS, FIRE_PANEL
  contactPerson        String
  designation          String?
  email                String
  phone                String
  alternatePhone       String?
  website              String?
  address              String
  country              String   @default("India")
  state                String
  district             String
  city                 String
  pincode              String
  ownerName            String?
  staffCount           Int      @default(0)
  gstStatus            String   @default("GST_REGISTERED") // GST_REGISTERED, NO_GST
  noGstReason          String?  // UNREGISTERED_BUSINESS, INDIVIDUAL_CONSUMER, EXEMPTED_GOODS, BELOW_TURNOVER_THRESHOLD, OTHER
  gstVerified          Boolean  @default(false)
  gstVerifiedAt        DateTime?
  gstProviderRef       String?
  tradeName            String?
  companyType          String?  @default("PVT_LTD") // PVT_LTD, PUBLIC_LTD, PROPRIETORSHIP, PARTNERSHIP, LLP, GOVT, INDIVIDUAL, OTHER
  numEmployees         Int?     @default(0)
  turnover             String?
  industry             String?
  source               String?  @default("DIRECT")
  customerRating       Float    @default(5.0)
  creditLimit          Float    @default(0)
  paymentTerms         String?  @default("NET_30")
  potentialValue       Float    @default(0)
  status               String   @default("ACTIVE") // ACTIVE, INACTIVE, DORMANT, BLOCKED, DELETED
  assignedStaffId      String?
  salesManagerStaffId  String?
  createdByUserId      String?
  updatedByUserId      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  createdByUser        User?    @relation("CustomerCreator", fields: [createdByUserId], references: [id])
  updatedByUser        User?    @relation("CustomerUpdater", fields: [updatedByUserId], references: [id])
  assignedStaff        Staff?   @relation("CustomerAssignee", fields: [assignedStaffId], references: [id])
  salesManagerStaff    Staff?   @relation("CustomerManager", fields: [salesManagerStaffId], references: [id])
  contacts             CustomerContact[]
  interactions         CustomerInteraction[]
  valuations           CustomerValuation?
  valuationHistory     CompanyValuationHistory[]
  productInterests     CompanyProductInterest[]
  leads                Lead[]
  enquiries            Enquiry[]
  opportunities        Opportunity[]
  activities           CrmActivity[]
  followUps            CrmFollowUp[]
  documents            CustomerDocument[]
  media                CustomerMedia[]
  panelSpecs           PanelSpecification[]
  projects             Project[]
  quotations           Quotation[]
  salesOrders          SalesOrder[]
  salesInvoices        SalesInvoice[]
  salesPayments        SalesPayment[]

  @@map("customers")
  @@index([status])
  @@index([assignedStaffId])
  @@index([customerType])
}

model ProductSystem {
  id          String   @id @default(uuid())
  code        String   @unique // VFD_PANEL, BOOSTER_PUMP, STP, BMS, HVAC, DEWATERING, FIRE_PANEL, SOLAR_PUMP, RO_PLANT
  name        String
  category    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  companyInterests CompanyProductInterest[]

  @@map("product_systems")
}

model CompanyProductInterest {
  id              String   @id @default(uuid())
  customerId      String
  productSystemId String
  interestLevel   String   @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  notes           String?
  createdAt       DateTime @default(now())

  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productSystem ProductSystem @relation(fields: [productSystemId], references: [id], onDelete: Cascade)

  @@unique([customerId, productSystemId])
  @@map("company_product_interests")
}

model CompanyValuationHistory {
  id            String   @id @default(uuid())
  customerId    String
  oldRating     Float?
  newRating     Float
  oldValueScore Float?
  newValueScore Float
  calculatedBy  String   // SYSTEM, STAFF
  staffId       String?
  reason        String?
  createdAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("company_valuation_history")
}

model CustomerContact {
  id                     String   @id @default(uuid())
  customerId             String
  name                   String
  designation            String?
  department             String?
  phone                  String?
  mobile                 String
  email                  String?
  whatsapp               String?
  isPrimary              Boolean  @default(false)
  isDecisionMaker        Boolean  @default(false)
  isTechnical            Boolean  @default(false)
  isCommercial           Boolean  @default(false)
  isPurchase             Boolean  @default(false)
  preferredCommunication String   @default("CALL") // CALL, WHATSAPP, EMAIL
  notes                  String?
  createdAt              DateTime @default(now())

  customer               Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  interactions           CustomerInteraction[]
  activities             CrmActivity[]
  calls                  CrmCall[]

  @@map("customer_contacts")
}

model CustomerInteraction {
  id              String   @id @default(uuid())
  customerId      String
  contactId       String?
  interactionType String   // CALL, EMAIL, WHATSAPP, MEETING, VISIT, DEMO, FOLLOWUP
  interactionDate DateTime @default(now())
  subject         String
  description     String
  outcome         String?
  nextFollowUp    DateTime?
  recordedBy      String
  attachmentUrl   String?
  audioUrl        String?
  photoUrl        String?
  createdAt       DateTime @default(now())

  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact  CustomerContact? @relation(fields: [contactId], references: [id])

  @@map("customer_interactions")
}

model CustomerValuation {
  id                 String   @id @default(uuid())
  customerId         String   @unique
  vfdWorkScore       Float    @default(0)
  dewateringWorkScore Float   @default(0)
  isDealer           Boolean  @default(false)
  isDistributor      Boolean  @default(false)
  ratingScore        Float    @default(5.0)
  valuablePercentage Float    @default(50.0)
  activityCount      Int      @default(0)
  engagementScore    Float    @default(50.0)
  lifetimeValue      Float    @default(0)
  dealerName         String?
  distributorName    String?
  updatedAt          DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_valuations")
}

// -------------------------------------------------------------
// 4. VENDOR & PRODUCT MASTERS
// -------------------------------------------------------------

model Vendor {
  id               String   @id @default(uuid())
  vendorCode       String   @unique // VEN-2026-00001
  companyName      String
  legalName        String?
  gstin            String?
  pan              String?
  vendorType       String?  @default("MANUFACTURER") // MANUFACTURER, DEALER, DISTRIBUTOR, SERVICE_PROVIDER, IMPORTER, OTHER
  vendorCategory   String?  @default("STANDARD")
  contactPerson    String
  designation      String?
  email            String
  phone            String
  alternatePhone   String?
  website          String?
  address          String
  country          String   @default("India")
  state            String
  district         String?
  city             String
  pincode          String?
  productsSupplied String?
  paymentTerms             String?   @default("NET_30")
  creditLimit              Float     @default(0)
  rating                   Float     @default(5.0)
  status                   String    @default("ACTIVE")
  assignedStaffId          String?
  createdByUserId          String?
  updatedByUserId          String?
  constitution             String?   @default("PROPRIETORSHIP")
  registeredOfficeLocation String?
  factoryLocation          String?
  msmeStatus               String?   @default("NO")
  approvalStatus           String?   @default("APPROVED")
  onboardingDate           DateTime? @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  assignedStaff            Staff?    @relation("VendorAssignee", fields: [assignedStaffId], references: [id])
  createdByUser            User?     @relation("VendorCreator", fields: [createdByUserId], references: [id])
  updatedByUser            User?     @relation("VendorUpdater", fields: [updatedByUserId], references: [id])

  contacts         VendorContact[]
  addresses        VendorAddress[]
  bankAccounts     VendorBankAccount[]
  rfqVendors       RFQVendor[]
  quotations       VendorQuotation[]
  purchaseOrders   PurchaseOrder[]
  inwardEntries    InwardEntry[]
  purchaseInvoices PurchaseInvoice[]
  purchasePayments PurchasePayment[]
  cheques          Cheque[]
  purchaseReturns  PurchaseReturn[]

  @@map("vendors")
}

model ProductCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  products  Product[]

  @@map("product_categories")
}

model Unit {
  id        String    @id @default(uuid())
  name      String    @unique // Nos, Sets, Meters, Kg, Liters
  code      String    @unique
  products  Product[]

  @@map("units")
}

model Product {
  id            String   @id @default(uuid())
  sku           String   @unique
  name          String
  categoryId    String
  productType   String   @default("FINISHED_PRODUCT") // FINISHED_PRODUCT, RAW_MATERIAL, COMPONENT, SERVICE
  description   String?
  unitId        String
  taxRateId     String?
  hsnSac        String?
  purchasePrice Float
  sellingPrice  Float
  minSellingPrice Float?
  reorderLevel  Int      @default(10)
  openingStock  Int      @default(0)
  currentStock  Int      @default(0)
  imageUrl      String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category          ProductCategory           @relation(fields: [categoryId], references: [id])
  unit              Unit                      @relation(fields: [unitId], references: [id])
  taxRate           TaxRate?                  @relation(fields: [taxRateId], references: [id])
  bomItems          PanelBOMItem[]
  stockItems        StockItem[]
  stockTransactions StockTransaction[]
  prItems           PurchaseRequisitionItem[]
  rfqItems          RFQItem[]
  quotationItems    VendorQuotationItem[]
  poItems           PurchaseOrderItem[]
  inwardItems       InwardEntryItem[]
  returnItems       PurchaseReturnItem[]
  salesQuotationItems QuotationItem[]
  salesOrderItems     SalesOrderItem[]
  salesInvoiceItems   SalesInvoiceItem[]

  @@map("products")
}

// -------------------------------------------------------------
// 5. CRM (LEADS, ENQUIRIES, OPPORTUNITIES & ACTIVITIES)
// -------------------------------------------------------------

model Lead {
  id                     String   @id @default(uuid())
  leadNumber             String   @unique // LEAD-2026-00001
  companyName            String
  contactPerson          String
  phone                  String
  email                  String?
  source                 String?  @default("EXHIBITION")
  leadType               String?  @default("END_CUSTOMER")
  productInterest        String?
  requirement            String?
  estimatedValue         Float    @default(0)
  assignedTo             String?
  assignedStaffId        String?
  salesManagerStaffId    String?
  priority               String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status                 String   @default("NEW") // NEW, CONTACTED, QUALIFIED, OPPORTUNITY, WON, LOST, DISQUALIFIED
  qualificationStatus    String   @default("PENDING") // PENDING, QUALIFIED, DISQUALIFIED
  bantBudget             Float?
  bantAuthority          String?
  bantNeed               String?
  bantTimeline           String?
  disqualificationReason String?
  customerId             String?
  nextFollowUp           DateTime?
  expectedClosureDate    DateTime?
  remarks                String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  customer               Customer?     @relation(fields: [customerId], references: [id])
  assignedStaff          Staff?        @relation("LeadAssignee", fields: [assignedStaffId], references: [id])
  salesManagerStaff      Staff?        @relation("LeadManager", fields: [salesManagerStaffId], references: [id])
  opportunities          Opportunity[]
  activities             CrmActivity[]

  @@map("leads")
  @@index([status])
  @@index([assignedStaffId])
  @@index([customerId])
  @@index([createdAt])
}

model Enquiry {
  id              String   @id @default(uuid())
  enquiryNumber   String   @unique // ENQ-2026-00001
  customerId      String
  enquiryDate     DateTime @default(now())
  productInterest String
  quantity        Int      @default(1)
  requirement     String?
  expectedValue   Float    @default(0)
  assignedTo      String?
  assignedStaffId String?
  priority        String   @default("MEDIUM")
  status          String   @default("PENDING") // PENDING, QUOTED, CLOSED_WON, CLOSED_LOST
  followUpDate    DateTime?
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer        Customer      @relation(fields: [customerId], references: [id])
  assignedStaff   Staff?        @relation("EnquiryAssignee", fields: [assignedStaffId], references: [id])
  opportunities   Opportunity[]
  quotations      Quotation[]

  @@map("enquiries")
}

model Opportunity {
  id                  String   @id @default(uuid())
  opportunityNumber   String   @unique // OPP-2026-00001
  title               String
  customerId          String
  contactId           String?
  leadId              String?
  enquiryId           String?
  assignedStaffId     String
  salesManagerStaffId String?
  stage               String   @default("QUALIFICATION") // QUALIFICATION, REQUIREMENT, TECHNICAL_EVALUATION, QUOTATION_SENT, NEGOTIATION, CLOSED_WON, CLOSED_LOST
  probability         Int      @default(10) // 10, 25, 40, 60, 80, 100, 0
  estimatedValue      Float    @default(0)
  weightedValue       Float    @default(0)
  expectedCloseDate   DateTime?
  priority            String   @default("MEDIUM")
  lostReason          String?
  lostRemarks         String?
  competitor          String?
  poNumber            String?
  poDate              DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  customer            Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedStaff       Staff         @relation("OppAssignee", fields: [assignedStaffId], references: [id])
  salesManagerStaff   Staff?        @relation("OppManager", fields: [salesManagerStaffId], references: [id])
  lead                Lead?         @relation(fields: [leadId], references: [id])
  enquiry             Enquiry?      @relation(fields: [enquiryId], references: [id])
  activities          CrmActivity[]
  followUps           CrmFollowUp[]
  quotations          Quotation[]

  @@map("opportunities")
  @@index([stage])
  @@index([customerId])
  @@index([assignedStaffId])
  @@index([createdAt])
}

model CrmActivity {
  id             String   @id @default(uuid())
  activityType   String   // CALL, MEETING, SITE_VISIT, DEMO, EMAIL, WHATSAPP, QUOTATION_SENT, STATUS_CHANGE, NOTE
  customerId     String?
  contactId      String?
  leadId         String?
  opportunityId  String?
  staffId        String
  subject        String
  description    String?
  outcome        String?
  nextActionDate DateTime?
  createdAt      DateTime @default(now())

  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact        CustomerContact? @relation(fields: [contactId], references: [id])
  lead           Lead?            @relation(fields: [leadId], references: [id])
  opportunity    Opportunity?     @relation(fields: [opportunityId], references: [id])
  staff          Staff            @relation(fields: [staffId], references: [id])
  call           CrmCall?
  meeting        CrmMeeting?
  siteVisit      CrmSiteVisit?

  @@map("crm_activities")
  @@index([customerId])
  @@index([staffId])
  @@index([opportunityId])
  @@index([createdAt])
}

model CrmCall {
  id           String   @id @default(uuid())
  activityId   String   @unique
  contactId    String?
  callType     String   @default("OUTBOUND") // INBOUND, OUTBOUND
  durationSec  Int      @default(0)
  callOutcome  String   @default("CONNECTED") // CONNECTED, BUSY, NO_ANSWER, WRONG_NUMBER, CALL_BACK, INTERESTED, NOT_INTERESTED
  recordingUrl String?
  dataSent     Boolean  @default(false)
  dataTypes    String?  // JSON string array e.g. ["QUOTATION", "CATALOG", "DRAWING"]

  activity     CrmActivity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  contact      CustomerContact? @relation(fields: [contactId], references: [id])
  recordings   CallRecording[]

  @@map("crm_calls")
}

model CallRecording {
  id            String   @id @default(uuid())
  callId        String
  fileName      String
  fileUrl       String
  durationSec   Int      @default(0)
  fileSizeBytes Int      @default(0)
  mimeType      String?  @default("audio/webm")
  uploadedBy    String?
  createdAt     DateTime @default(now())

  call CrmCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("call_recordings")
}

model CrmMeeting {
  id                 String    @id @default(uuid())
  activityId         String    @unique
  meetingType        String    @default("OFFLINE") // OFFLINE, ONLINE_TEAMS, ONLINE_ZOOM, CLIENT_OFFICE
  location           String?
  startTime          DateTime
  endTime            DateTime?
  agenda             String?
  outcome            String?
  hostStaffId        String?
  requestedByStaffId String?
  meetingStatus      String    @default("SCHEDULED") // REQUESTED, ACCEPTED, RESCHEDULE_PROPOSED, SCHEDULED, COMPLETED, CANCELLED, DECLINED
  rescheduleReason   String?
  rescheduleCount    Int       @default(0)

  activity           CrmActivity              @relation(fields: [activityId], references: [id], onDelete: Cascade)
  hostStaff          Staff?                   @relation("MeetingHost", fields: [hostStaffId], references: [id])
  scheduleHistory    MeetingScheduleHistory[]

  @@map("crm_meetings")
}

model MeetingScheduleHistory {
  id                String    @id @default(uuid())
  meetingId         String
  previousStartTime DateTime
  previousEndTime   DateTime?
  newStartTime       DateTime
  newEndTime         DateTime?
  changedByStaffId  String
  reason            String?
  statusBefore      String?
  statusAfter       String?
  createdAt         DateTime  @default(now())

  meeting CrmMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_schedule_history")
}

model CrmSiteVisit {
  id              String   @id @default(uuid())
  activityId      String   @unique
  location        String
  siteCondition   String?
  voltageReading  String?
  pumpRatingHp    Float?
  panelDimensions String?
  inspectionNotes String?
  photoUrls       String? // JSON string array of photo URLs

  activity        CrmActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("crm_site_visits")
}

model CrmFollowUp {
  id              String    @id @default(uuid())
  title           String
  customerId      String?
  opportunityId   String?
  leadId          String?
  assignedStaffId String
  followUpNumber  Int?
  activityType    String    @default("CALL")
  subject         String?
  discussion      String?
  outcome         String?
  nextAction      String?
  interactionDate DateTime?
  scheduledDate   DateTime?
  reminderMinutes Int?
  status          String    @default("PENDING") // PENDING, COMPLETED, OVERDUE, CANCELLED
  priority        String    @default("MEDIUM")
  notes           String?
  completedDate   DateTime?
  createdAt       DateTime  @default(now())

  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignedStaff   Staff        @relation(fields: [assignedStaffId], references: [id])

  @@map("crm_follow_ups")
  @@unique([customerId, followUpNumber])
  @@index([assignedStaffId])
  @@index([status])
  @@index([scheduledDate])
}

model CustomerDocument {
  id                String   @id @default(uuid())
  customerId        String
  documentType      String   // GST_CERTIFICATE, PAN_CARD, PO_COPY, CAD_DRAWING, SLD, CONTRACT, OTHER
  title             String
  fileUrl           String
  fileName          String
  fileSize          Int      @default(0)
  mimeType          String?
  uploadedByStaffId String
  createdAt         DateTime @default(now())

  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff             Staff    @relation(fields: [uploadedByStaffId], references: [id])

  @@map("customer_documents")
}

model CustomerMedia {
  id                String   @id @default(uuid())
  customerId        String
  mediaType         String   // PHOTO_SITE, PHOTO_PANEL, PHOTO_OFFICE, AUDIO_CALL, AUDIO_NOTE
  title             String?
  fileUrl           String
  durationSec       Int?     // For audio recordings
  uploadedByStaffId String
  createdAt         DateTime @default(now())

  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff             Staff    @relation(fields: [uploadedByStaffId], references: [id])

  @@map("customer_media")
}

model CrmSavedFilter {
  id         String   @id @default(uuid())
  name       String
  staffId    String
  entityType String   // CUSTOMER, LEAD, OPPORTUNITY, FOLLOW_UP
  filterJson String   // JSON string of active filter criteria
  isShared   Boolean  @default(false)
  createdAt  DateTime @default(now())

  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("crm_saved_filters")
}

// -------------------------------------------------------------
// 6. CLIENT SPECIFIC: PANEL MANUFACTURING & BOM
// -------------------------------------------------------------

model PanelSpecification {
  id            String   @id @default(uuid())
  panelCode     String   @unique // PANEL-2026-0001
  customerId    String
  panelType     String   // VFD_PANEL, BOOSTER_PUMP, STP_PANEL, HVAC_PANEL, DEWATERING_PANEL
  voltage       String   @default("415V 3-Phase")
  currentRating String   @default("100A")
  pumpQty       Int      @default(2)
  pumpHp        Float    @default(7.5)
  controlType   String   @default("AUTOMATIC_PLC") // AUTOMATIC_PLC, MANUAL, STAR_DELTA, DOL
  starterType   String?  @default("VFD")
  ipRating      String   @default("IP55")
  enclosureType String   @default("POWDER_COATED_MS")
  
  // Costing & Formula Breakdown
  materialCost  Float    @default(0)
  labourCost    Float    @default(0)
  overheadCost  Float    @default(0)
  marginPercent Float    @default(15.0)
  finalPrice    Float    @default(0)
  status        String   @default("DRAFT") // DRAFT, APPROVED, IN_PRODUCTION
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id])
  bomItems PanelBOMItem[]
  quotations Quotation[]

  @@map("panel_specifications")
}

model PanelBOMItem {
  id            String @id @default(uuid())
  panelSpecId   String
  productId     String?
  componentName String
  specification String?
  manufacturer  String?
  quantity      Int    @default(1)
  unitPrice     Float  @default(0)
  totalPrice    Float  @default(0)

  panelSpec PanelSpecification @relation(fields: [panelSpecId], references: [id], onDelete: Cascade)
  product   Product?           @relation(fields: [productId], references: [id])

  @@map("panel_bom_items")
}

// -------------------------------------------------------------
// COMMERCIAL SALES QUOTATIONS & SALES ORDERS
// -------------------------------------------------------------

model Quotation {
  id                  String   @id @default(uuid())
  quotationNumber     String   // e.g. QUO-2026-00001
  revisionNumber      Int      @default(0) // 0 for REV-0, 1 for REV-1, 2 for REV-2
  code                String   @unique // e.g. QUO-2026-00001-REV-0
  customerId          String
  opportunityId       String?
  enquiryId           String?
  panelSpecId         String?
  assignedStaffId     String?
  quotationDate       DateTime @default(now())
  validUntil          DateTime?
  subject             String
  currency            String   @default("INR")
  subtotal            Float    @default(0)
  discountPercent     Float    @default(0)
  discountAmount      Float    @default(0)
  taxableAmount       Float    @default(0)
  cgstPercent         Float    @default(9.0)
  cgstAmount          Float    @default(0)
  sgstPercent         Float    @default(9.0)
  sgstAmount          Float    @default(0)
  igstPercent         Float    @default(0)
  igstAmount          Float    @default(0)
  grandTotal          Float    @default(0)
  paymentTerms        String?  @default("50% Advance, 50% Against Proforma Invoice before Dispatch")
  deliveryTerms       String?  @default("2 to 3 weeks from receipt of PO and technical clearance")
  freightTerms        String?  @default("Ex-Works Pune. Freight extra at actuals.")
  warrantyTerms       String?  @default("18 months from date of supply or 12 months from commissioning, whichever is earlier.")
  notes               String?
  status              String   @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, SENT, ACCEPTED, REJECTED, EXPIRED, CONVERTED
  approvedByStaffId   String?
  approvedAt          DateTime?
  sentAt              DateTime?
  acceptedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity         Opportunity?        @relation(fields: [opportunityId], references: [id])
  enquiry             Enquiry?            @relation(fields: [enquiryId], references: [id])
  panelSpec           PanelSpecification? @relation(fields: [panelSpecId], references: [id])
  assignedStaff       Staff?              @relation("QuotationAssignee", fields: [assignedStaffId], references: [id])
  approvedByStaff     Staff?              @relation("QuotationApprover", fields: [approvedByStaffId], references: [id])
  items               QuotationItem[]
  salesOrders         SalesOrder[]

  @@map("quotations")
  @@index([customerId])
  @@index([status])
  @@index([quotationNumber])
  @@index([createdAt])
}

model QuotationItem {
  id              String   @id @default(uuid())
  quotationId     String
  productId       String?
  itemCode        String?
  description     String
  hsnSac          String?  @default("8537") // Standard electrical control panel HSN code
  quantity        Int      @default(1)
  unit            String   @default("Nos")
  unitPrice       Float    @default(0)
  discountPercent Float    @default(0)
  taxableAmount   Float    @default(0)
  gstPercent      Float    @default(18.0)
  gstAmount       Float    @default(0)
  totalAmount     Float    @default(0)
  sortOrder       Int      @default(0)

  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product         Product?  @relation(fields: [productId], references: [id])

  @@map("quotation_items")
}

model SalesOrder {
  id                String    @id @default(uuid())
  orderNumber       String    @unique // SO-2026-00001
  quotationId       String?
  customerId        String
  poNumber          String?
  poDate            DateTime?
  orderDate         DateTime  @default(now())
  deliveryDate      DateTime?
  assignedStaffId   String?
  subtotal          Float     @default(0)
  discountAmount    Float     @default(0)
  taxableAmount     Float     @default(0)
  taxAmount         Float     @default(0)
  grandTotal        Float     @default(0)
  paymentTerms      String?
  shippingAddress   String?
  billingAddress    String?
  status            String    @default("CONFIRMED") // DRAFT, CONFIRMED, IN_PRODUCTION, READY_FOR_DISPATCH, DISPATCHED, DELIVERED, CANCELLED
  productionStatus  String    @default("PENDING") // PENDING, SCHEDULED, IN_ASSEMBLY, TESTING, COMPLETED
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  quotation         Quotation?       @relation(fields: [quotationId], references: [id])
  customer          Customer         @relation(fields: [customerId], references: [id])
  assignedStaff     Staff?           @relation("SalesOrderAssignee", fields: [assignedStaffId], references: [id])
  items             SalesOrderItem[]
  invoices          SalesInvoice[]

  @@map("sales_orders")
  @@index([customerId])
  @@index([status])
  @@index([productionStatus])
  @@index([createdAt])
}

model SalesOrderItem {
  id            String     @id @default(uuid())
  salesOrderId  String
  productId     String?
  description   String
  quantity      Int        @default(1)
  unitPrice     Float      @default(0)
  taxAmount     Float      @default(0)
  totalAmount   Float      @default(0)

  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product       Product?   @relation(fields: [productId], references: [id])

  @@map("sales_order_items")
}

model SalesInvoice {
  id               String             @id @default(uuid())
  invoiceNumber    String             @unique // INV-2026-00001
  salesOrderId     String?
  customerId       String
  financialYear    String?            @default("2025-26")
  invoiceDate      DateTime           @default(now())
  dueDate          DateTime?
  poNumber         String?
  ewayBillNumber   String?
  irnNumber        String?
  subtotal         Float              @default(0)
  discountAmount   Float              @default(0)
  taxableAmount    Float              @default(0)
  cgstAmount       Float              @default(0)
  sgstAmount       Float              @default(0)
  igstAmount       Float              @default(0)
  taxAmount        Float              @default(0)
  grandTotal       Float              @default(0)
  paidAmount       Float              @default(0)
  balanceDue       Float              @default(0)
  paymentStatus    String             @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  status           String             @default("ISSUED") // DRAFT, ISSUED, PAID, CANCELLED
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  customer         Customer           @relation(fields: [customerId], references: [id])
  salesOrder       SalesOrder?        @relation(fields: [salesOrderId], references: [id])
  items            SalesInvoiceItem[]
  payments         SalesPayment[]

  @@map("sales_invoices")
  @@index([customerId])
  @@index([paymentStatus])
  @@index([dueDate])
  @@index([createdAt])
}

model SalesInvoiceItem {
  id              String       @id @default(uuid())
  salesInvoiceId  String
  productId       String?
  itemCode        String?
  description     String
  hsnSac          String?      @default("8537")
  quantity        Int          @default(1)
  unit            String       @default("Nos")
  unitPrice       Float        @default(0)
  taxableAmount   Float        @default(0)
  gstPercent      Float        @default(18.0)
  gstAmount       Float        @default(0)
  totalAmount     Float        @default(0)

  invoice         SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  product         Product?     @relation(fields: [productId], references: [id])

  @@map("sales_invoice_items")
}

model SalesPayment {
  id                String       @id @default(uuid())
  receiptNumber     String       @unique // REC-2026-00001
  salesInvoiceId    String
  customerId        String
  paymentDate       DateTime     @default(now())
  amount            Float
  paymentMode       String       // NEFT, RTGS, CHEQUE, UPI, CASH
  referenceNumber   String?      // UTR / Cheque No
  bankName          String?
  notes             String?
  createdAt         DateTime     @default(now())

  invoice           SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  customer          Customer     @relation(fields: [customerId], references: [id])

  @@map("sales_payments")
}

// -------------------------------------------------------------
// 7. INVENTORY & WAREHOUSES
// -------------------------------------------------------------

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  location  String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  stockItems        StockItem[]
  stockTransactions StockTransaction[]
  inwardEntries     InwardEntry[]

  @@map("warehouses")
}

model StockItem {
  id               String   @id @default(uuid())
  warehouseId      String
  productId        String
  currentQuantity  Int      @default(0)
  reservedQuantity Int      @default(0)
  updatedAt        DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@map("stock_items")
}

// -------------------------------------------------------------
// 8. PURCHASE & PROCUREMENT & STOCK TRANSACTIONS
// -------------------------------------------------------------

model VendorContact {
  id              String   @id @default(uuid())
  vendorId        String
  contactPerson   String
  designation     String?
  mobile          String
  alternateMobile String?
  email           String?
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_contacts")
}

model VendorAddress {
  id          String   @id @default(uuid())
  vendorId    String
  addressType String   @default("BILLING") // BILLING, SHIPPING, FACTORY, WAREHOUSE
  addressLine String
  country     String   @default("India")
  state       String
  district    String?
  city        String
  location    String?
  pincode     String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_addresses")
}

model VendorBankAccount {
  id            String   @id @default(uuid())
  vendorId      String
  accountHolder String
  bankName      String
  accountNumber String
  ifscCode      String
  branch        String?
  accountType   String   @default("CURRENT") // CURRENT, SAVINGS
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_bank_accounts")
}

model PurchaseRequisition {
  id            String   @id @default(uuid())
  prNumber      String   @unique // PR-2026-00001
  requesterId   String?
  requesterName String
  departmentId  String?
  date          DateTime @default(now())
  requiredDate  DateTime?
  priority      String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  purpose       String?
  estimatedCost Float    @default(0)
  status        String   @default("SUBMITTED") // DRAFT, SUBMITTED, APPROVED, REJECTED, CANCELLED
  approvedBy    String?
  approvalDate  DateTime?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items PurchaseRequisitionItem[]

  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id              String  @id @default(uuid())
  prId            String
  productId       String?
  itemDescription String
  quantity        Float
  unit            String
  estimatedRate   Float   @default(0)
  estimatedAmount Float   @default(0)

  pr      PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  product Product?            @relation(fields: [productId], references: [id])

  @@map("purchase_requisition_items")
}

model RFQ {
  id            String    @id @default(uuid())
  rfqNumber     String    @unique // RFQ-2026-00001
  date          DateTime  @default(now())
  departmentId  String?
  requesterName String
  requiredDate  DateTime?
  closingDate   DateTime?
  status        String    @default("OPEN") // OPEN, CLOSED, CANCELLED
  remarks       String?
  createdAt     DateTime  @default(now())

  items      RFQItem[]
  vendors    RFQVendor[]
  quotations VendorQuotation[]

  @@map("rfqs")
}

model RFQItem {
  id              String  @id @default(uuid())
  rfqId           String
  productId       String?
  itemDescription String
  quantity        Float
  unit            String

  rfq     RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("rfq_items")
}

model RFQVendor {
  id       String @id @default(uuid())
  rfqId    String
  vendorId String
  status   String @default("INVITED") // INVITED, QUOTED, DECLINED

  rfq    RFQ    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([rfqId, vendorId])
  @@map("rfq_vendors")
}

model VendorQuotation {
  id              String    @id @default(uuid())
  quotationNumber String    @unique // VQ-2026-00001
  vendorId        String
  rfqId           String?
  date            DateTime  @default(now())
  validityDate    DateTime?
  deliveryTime    String?
  paymentTerms    String?
  subtotal        Float     @default(0)
  discount        Float     @default(0)
  taxAmount       Float     @default(0)
  totalAmount     Float     @default(0)
  isSelected      Boolean   @default(false)
  selectionReason String?
  remarks         String?
  createdAt       DateTime  @default(now())

  vendor Vendor                @relation(fields: [vendorId], references: [id])
  rfq    RFQ?                  @relation(fields: [rfqId], references: [id])
  items  VendorQuotationItem[]

  @@map("vendor_quotations")
}

model VendorQuotationItem {
  id              String  @id @default(uuid())
  quotationId     String
  productId       String?
  itemDescription String
  quantity        Float
  unit            String
  rate            Float
  discount        Float   @default(0)
  taxRate         Float   @default(0)
  taxAmount       Float   @default(0)
  totalAmount     Float

  quotation VendorQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?        @relation(fields: [productId], references: [id])

  @@map("vendor_quotation_items")
}

model PurchaseOrder {
  id               String    @id @default(uuid())
  poNumber         String    @unique // PO-2026-00001
  vendorId         String
  rfqId            String?
  quotationId      String?
  date             DateTime  @default(now())
  expectedDelivery DateTime?
  departmentId     String?
  warehouseId      String?
  paymentTerms     String?
  subtotal         Float     @default(0)
  discount         Float     @default(0)
  taxAmount        Float     @default(0)
  totalAmount      Float     @default(0)
  status           String    @default("DRAFT") // DRAFT, SUBMITTED, PENDING_APPROVAL, APPROVED, PARTIALLY_RECEIVED, COMPLETED, CANCELLED
  approvedBy       String?
  approvalDate     DateTime?
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vendor           Vendor              @relation(fields: [vendorId], references: [id])
  items            PurchaseOrderItem[]
  inwardEntries    InwardEntry[]
  purchaseInvoices PurchaseInvoice[]

  @@map("purchase_orders")
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id               String  @id @default(uuid())
  poId             String
  productId        String?
  itemDescription  String
  orderedQuantity  Float
  receivedQuantity Float   @default(0)
  unit             String
  rate             Float
  discount         Float   @default(0)
  taxRate          Float   @default(0)
  taxAmount        Float   @default(0)
  totalAmount      Float

  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product Product?      @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

model InwardEntry {
  id                   String    @id @default(uuid())
  inwardNumber         String    @unique // GRN-2026-00001
  inwardDate           DateTime  @default(now())
  vendorId             String
  purchaseOrderId      String?
  vendorInvoiceNumber  String
  invoiceDate          DateTime?
  departmentId         String?
  warehouseId          String?
  receivedBy           String
  transporter          String?
  vehicleNumber        String?
  lrNumber             String?
  deliveryChallanNumber String?
  subtotal             Float     @default(0)
  discount             Float     @default(0)
  taxAmount            Float     @default(0)
  grandTotal           Float     @default(0)
  remarks              String?
  attachmentUrl        String?
  status               String    @default("RECEIVED") // RECEIVED, QC_PENDING, QC_COMPLETED, REJECTED
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  purchaseOrder    PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  warehouse        Warehouse?        @relation(fields: [warehouseId], references: [id])
  items            InwardEntryItem[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]

  @@map("inward_entries")
  @@index([vendorId])
  @@index([purchaseOrderId])
  @@index([status])
}

model InwardEntryItem {
  id               String    @id @default(uuid())
  inwardEntryId    String
  productId        String
  poItemId         String?
  quantity         Float
  unit             String
  rate             Float
  discount         Float     @default(0)
  taxRate          Float     @default(0)
  taxAmount        Float     @default(0)
  amount           Float
  batchNumber      String?
  serialNumber     String?
  expiryDate       DateTime?
  qcRequired       Boolean   @default(true)
  qcStatus         String    @default("PENDING") // PENDING, ACCEPTED, PARTIALLY_ACCEPTED, REJECTED
  acceptedQuantity Float     @default(0)
  rejectedQuantity Float     @default(0)
  rejectionReason  String?
  inspectedBy      String?
  inspectionDate   DateTime?
  stockUpdated     Boolean   @default(false)

  inwardEntry InwardEntry @relation(fields: [inwardEntryId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@map("inward_entry_items")
}

model StockTransaction {
  id              String   @id @default(uuid())
  productId       String
  warehouseId     String
  transactionType String   // INWARD_GRN, PURCHASE_RETURN, ADJUSTMENT, STOCK_IN, STOCK_OUT, TRANSFER
  referenceType   String   // INWARD, PURCHASE_RETURN, MANUAL
  referenceId     String?
  quantity        Float    // Positive for IN, Negative for OUT
  unit            String
  unitCost        Float    @default(0)
  totalCost       Float    @default(0)
  batchNumber     String?
  serialNumber    String?
  transactionDate DateTime @default(now())
  userId          String?
  notes           String?
  createdAt       DateTime @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("stock_transactions")
  @@index([productId])
  @@index([warehouseId])
  @@index([transactionDate])
}

model PurchaseInvoice {
  id              String    @id @default(uuid())
  invoiceNumber   String    @unique // PINV-2026-00001
  vendorId        String
  purchaseOrderId String?
  inwardEntryId   String?
  departmentId    String?
  financialYear   String?   // e.g. 2025-26
  invoiceDate     DateTime  @default(now())
  dueDate         DateTime?
  subtotal        Float     @default(0)
  discount        Float     @default(0)
  taxAmount       Float     @default(0)
  totalAmount     Float     @default(0)
  paidAmount      Float     @default(0)
  balanceAmount   Float     @default(0)
  status          String    @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  attachmentUrl   String?
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vendor          Vendor                @relation(fields: [vendorId], references: [id])
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  inwardEntry     InwardEntry?          @relation(fields: [inwardEntryId], references: [id])
  items           PurchaseInvoiceItem[]
  payments        PurchasePayment[]
  cheques         Cheque[]
  purchaseReturns PurchaseReturn[]

  @@map("purchase_invoices")
  @@index([vendorId])
  @@index([status])
  @@index([dueDate])
}

model PurchaseInvoiceItem {
  id              String  @id @default(uuid())
  invoiceId       String
  productId       String?
  itemDescription String
  quantity        Float
  unit            String
  rate            Float
  discount        Float   @default(0)
  taxRate         Float   @default(0)
  taxAmount       Float   @default(0)
  amount          Float

  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("purchase_invoice_items")
}

model PurchasePayment {
  id                String   @id @default(uuid())
  paymentNumber     String   @unique // PAY-2026-00001
  vendorId          String
  purchaseInvoiceId String
  paymentDate       DateTime @default(now())
  amount            Float
  paymentMode       String   // CASH, BANK_TRANSFER, UPI, NEFT, RTGS, CHEQUE, OTHER
  bankAccount       String?
  referenceNumber   String?
  transactionNumber String?
  remarks           String?
  attachmentUrl     String?
  status            String   @default("COMPLETED")
  createdAt         DateTime @default(now())

  vendor          Vendor          @relation(fields: [vendorId], references: [id])
  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  cheques         Cheque[]

  @@map("purchase_payments")
}

model Cheque {
  id                String    @id @default(uuid())
  chequeNumber      String
  vendorId          String
  purchaseInvoiceId String?
  purchasePaymentId String
  chequeDate        DateTime
  bankName          String
  branch            String?
  amount            Float
  payeeName         String
  depositDate       DateTime?
  clearanceDate     DateTime?
  status            String    @default("ISSUED") // ISSUED, DEPOSITED, CLEARED, BOUNCED, CANCELLED
  remarks           String?
  bounceReason      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  purchasePayment PurchasePayment  @relation(fields: [purchasePaymentId], references: [id], onDelete: Cascade)

  @@map("cheques")
}

model OutwardDocument {
  id              String   @id @default(uuid())
  outwardNumber   String   @unique // OUT-2026-00001
  date            DateTime @default(now())
  outwardType     String   // MATERIAL_OUTWARD, DOCUMENT_OUTWARD, SAMPLE, REPAIR, RETURN, DISPATCH, OTHER
  departmentId    String?
  fromLocation    String
  toLocation      String
  partyType       String?  // CUSTOMER, VENDOR, INTERNAL, OTHER
  partyId         String?
  partyName       String?
  personName      String?
  purpose         String?
  referenceNumber String?
  documentNumber  String?
  vehicleNumber   String?
  status          String   @default("DISPATCHED") // DRAFT, DISPATCHED, DELIVERED, CANCELLED
  remarks         String?
  attachmentUrl   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items OutwardDocumentItem[]

  @@map("outward_documents")
}

model OutwardDocumentItem {
  id           String  @id @default(uuid())
  outwardId    String
  productId    String?
  materialName String
  quantity     Float
  unit         String
  remarks      String?

  outward OutwardDocument @relation(fields: [outwardId], references: [id], onDelete: Cascade)

  @@map("outward_document_items")
}

model PurchaseReturn {
  id                String   @id @default(uuid())
  returnNumber      String   @unique // PRET-2026-00001
  vendorId          String
  inwardEntryId     String?
  purchaseInvoiceId String?
  returnDate        DateTime @default(now())
  reason            String
  subtotal          Float    @default(0)
  taxAmount         Float    @default(0)
  grandTotal        Float    @default(0)
  remarks           String?
  status            String   @default("RETURNED")
  attachmentUrl     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vendor          Vendor              @relation(fields: [vendorId], references: [id])
  inwardEntry     InwardEntry?        @relation(fields: [inwardEntryId], references: [id])
  purchaseInvoice PurchaseInvoice?    @relation(fields: [purchaseInvoiceId], references: [id])
  items           PurchaseReturnItem[]

  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id        String  @id @default(uuid())
  returnId  String
  productId String
  quantity  Float
  unit      String
  rate      Float
  amount    Float
  reason    String?

  return  PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])

  @@map("purchase_return_items")
}

// -------------------------------------------------------------
// 8. DOCUMENTS, NOTIFICATIONS & AUDIT LOGS
// -------------------------------------------------------------

model DocumentItem {
  id           String   @id @default(uuid())
  documentCode String   @unique // DOC-2026-0001
  name         String
  documentType String   // GST_CERT, PO_COPY, PANEL_DRAWING, INVOICE, MANUAL
  entityType   String   // CUSTOMER, VENDOR, PRODUCT, PROJECT, INVOICE
  entityId     String
  fileName     String
  fileSize     Int
  mimeType     String
  storagePath  String
  uploadedBy   String
  createdAt    DateTime @default(now())

  @@map("document_items")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  module    String   // CRM, SALES, INVENTORY, TASK
  entityId  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userEmail   String?
  action      String   // CREATE, UPDATE, DELETE, LOGIN, APPROVE, EXPORT
  module      String   // CUSTOMERS, LEADS, PRODUCTS, PANEL_MFG, AUTH
  entityType  String?
  entityId    String?
  details     String?
  ipAddress   String?
  timestamp   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
  @@index([userId])
  @@index([module])
  @@index([timestamp])
}

model UserSession {
  id              String    @id @default(uuid())
  userId          String
  username        String
  fullName        String
  email           String
  department      String?
  role            String?
  ipAddress       String?
  clientType      String?
  loginTime       DateTime  @default(now())
  logoutTime      DateTime?
  lastHeartbeat   DateTime  @default(now())
  durationSeconds Int?
  status          String    @default("ACTIVE") // ACTIVE, LOGGED_OUT, REVOKED, EXPIRED
  loginMethod     String    @default("CREDENTIALS_AND_BIOMETRIC_2FA")
  faceVerified    Boolean   @default(false)
  logoutReason    String?   // USER_LOGOUT, ADMIN_REVOKED, TIMEOUT, SYSTEM
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
  @@index([userId])
  @@index([status])
  @@index([loginTime])
}

// -------------------------------------------------------------
// 9. STAFF, PROJECTS & TASK MANAGEMENT
// -------------------------------------------------------------

model Staff {
  id                 String       @id @default(uuid())
  employeeId         String       @unique // EMP001
  fullName           String
  email              String       @unique
  mobile             String?
  profilePhoto       String?
  departmentId       String
  designationId      String
  reportingManagerId String?
  userId             String?      @unique
  status             String       @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  joiningDate        DateTime?
  location           String?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  department         Department   @relation(fields: [departmentId], references: [id])
  designation        Designation  @relation(fields: [designationId], references: [id])
  reportingManager   Staff?       @relation("StaffHierarchy", fields: [reportingManagerId], references: [id])
  subordinates       Staff[]      @relation("StaffHierarchy")
  user               User?        @relation(fields: [userId], references: [id])

  managedProjects    Project[]    @relation("ProjectManager")
  projectMemberships ProjectMember[]
  assignedTasks      Task[]       @relation("TaskAssignee")
  createdTasks       Task[]       @relation("TaskCreator")
  assignedByTasks    Task[]       @relation("TaskAssigner")
  taskComments       TaskComment[]
  taskActivities     TaskActivity[]

  assignedCustomers  Customer[]   @relation("CustomerAssignee")
  managedCustomers   Customer[]   @relation("CustomerManager")
  assignedVendors    Vendor[]     @relation("VendorAssignee")
  assignedLeads      Lead[]       @relation("LeadAssignee")
  managedLeads       Lead[]       @relation("LeadManager")
  assignedEnquiries  Enquiry[]    @relation("EnquiryAssignee")
  assignedOpps       Opportunity[] @relation("OppAssignee")
  managedOpps        Opportunity[] @relation("OppManager")
  crmActivities      CrmActivity[]
  crmFollowUps       CrmFollowUp[]
  customerDocuments  CustomerDocument[]
  customerMedia      CustomerMedia[]
  savedFilters       CrmSavedFilter[]
  hostedMeetings     CrmMeeting[] @relation("MeetingHost")
  assignedQuotations Quotation[]  @relation("QuotationAssignee")
  approvedQuotations Quotation[]  @relation("QuotationApprover")
  assignedSalesOrders SalesOrder[] @relation("SalesOrderAssignee")
  headedDepartment  Department? @relation("DepartmentHead")
  ledTeams           Team[]       @relation("TeamLeader")
  teamMemberships    TeamMember[]

  @@map("staff")
}

model Project {
  id                    String          @id @default(uuid())
  projectNumber         String          @unique // PRJ-2026-001
  name                  String
  description           String?
  customerId            String?
  projectType           String          @default("Customer Project")
  projectManagerStaffId String
  startDate             DateTime?
  endDate               DateTime?
  priority              String          @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  budget                Float           @default(0)
  status                String          @default("PLANNING") // PLANNING, ACTIVE, ON_HOLD, COMPLETED, CANCELLED
  health                String          @default("ON_TRACK") // ON_TRACK, AT_RISK, CRITICAL
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  customer              Customer?       @relation(fields: [customerId], references: [id])
  projectManager        Staff           @relation("ProjectManager", fields: [projectManagerStaffId], references: [id])
  members               ProjectMember[]
  milestones            Milestone[]
  tasks                 Task[]

  @@map("projects")
}

model ProjectMember {
  id                String    @id @default(uuid())
  projectId         String
  staffId           String
  projectRole       String    @default("Team Member")
  allocationPercent Int       @default(100)
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime  @default(now())

  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  staff             Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([projectId, staffId])
  @@map("project_members")
}

model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, DELAYED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@map("milestones")
}

model Task {
  id                 String         @id @default(uuid())
  taskNumber         String         @unique // TSK-2026-001
  title              String
  description        String?
  projectId          String?
  milestoneId        String?
  departmentId       String?
  teamId             String?
  assigneeStaffId    String?
  createdByStaffId   String
  assignedByStaffId  String?
  priority           String         @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status             String         @default("CREATED") // CREATED, ASSIGNED, ACCEPTED, IN_PROGRESS, PENDING, REVIEW, RETURNED, COMPLETED, CANCELLED
  dueDate            DateTime?
  estimatedHours     Float          @default(0)
  actualHours        Float          @default(0)
  progress           Int            @default(0) // 0 to 100
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  project            Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone          Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  department         Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team               Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignee           Staff?         @relation("TaskAssignee", fields: [assigneeStaffId], references: [id], onDelete: SetNull)
  creator            Staff          @relation("TaskCreator", fields: [createdByStaffId], references: [id])
  assigner           Staff?         @relation("TaskAssigner", fields: [assignedByStaffId], references: [id], onDelete: SetNull)
  comments           TaskComment[]
  activities         TaskActivity[]

  @@map("tasks")
  @@index([assigneeStaffId])
  @@index([status])
  @@index([projectId])
  @@index([teamId])
  @@index([dueDate])
}

model Team {
  id            String       @id @default(uuid())
  name          String
  code          String
  departmentId  String?
  leaderStaffId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  department Department? @relation("PrimaryTeamDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  departments TeamDepartment[]
  leader     Staff?      @relation("TeamLeader", fields: [leaderStaffId], references: [id], onDelete: SetNull)
  members    TeamMember[]
  tasks      Task[]

  @@unique([code])
  @@unique([name])
  @@map("teams")
}

model TeamDepartment {
  id           String   @id @default(uuid())
  teamId       String
  departmentId String
  createdAt    DateTime @default(now())

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([teamId, departmentId])
  @@index([departmentId])
  @@map("team_departments")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  staffId   String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([teamId, staffId])
  @@index([staffId])
  @@map("team_members")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  staffId   String
  comment   String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("task_comments")
}

model TaskActivity {
  id        String   @id @default(uuid())
  taskId    String
  staffId   String
  action    String   // STATUS_CHANGE, ASSIGNED, PROGRESS_UPDATE, COMMENTED
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("task_activities")
}

// -------------------------------------------------------------
// HUMAN RESOURCES & INDUSTRIAL WORKFORCE MANAGEMENT
// -------------------------------------------------------------

model ShiftMaster {
  id             String   @id @default(uuid())
  code           String   @unique // SHIFT_G, SHIFT_A, SHIFT_B, SHIFT_N
  name           String   // General Day Shift, Morning Assembly, Afternoon Shift, Night Testing Shift
  startTime      String   // "08:30"
  endTime        String   // "17:00"
  graceMinutes   Int      @default(15)
  shiftAllowance Float    @default(0) // Indian Factories Act: Night/hardship allowance e.g. 150 INR
  departmentName String?  @default("Shopfloor & Plant")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@map("shift_masters")
}

model Employee {
  id                  String   @id @default(uuid())
  employeeCode        String   @unique // EMP-2026-001
  userId              String?  @unique
  firstName           String
  middleName          String?
  lastName            String
  email               String   @unique
  phone               String
  designation         String
  departmentId        String?
  employmentType      String   @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERN
  workerCategory      String   @default("SHOPFLOOR_TECH") // STAFF_OFFICE, SHOPFLOOR_TECH, CONTRACT_LABOR, APPRENTICE
  skillLevel          String?  @default("LEVEL_2_WIREMAN") // LEVEL_1_TRAINEE, LEVEL_2_WIREMAN, LEVEL_3_BUSBAR_SPECIALIST, LEVEL_4_TESTING_EXPERT, STAFF_ENGINEER
  assignedBay         String?  @default("BAY_4_WIRING") // BAY_1_FABRICATION, BAY_2_BUSBAR, BAY_3_MOUNTING, BAY_4_WIRING, BAY_5_FAT_TESTING, BAY_6_DISPATCH
  shiftCode           String   @default("SHIFT_G")
  electricalLicenseNo String?  // e.g. "MH-PWD-WIREMAN-8492"
  contractorAgency    String?  // e.g. "Apex Industrial Solutions" (for contract labor)
  ppeKitIssued        Boolean  @default(true)
  lastSafetyTraining  DateTime?
  joiningDate         DateTime @default(now())
  status              String   @default("ACTIVE") // ACTIVE, ON_LEAVE, PROBATION, RESIGNED
  salaryCtc           Float    @default(0)
  bankAccountNo       String?
  bankIfsc            String?
  panNo               String?
  aadhaarNo           String?
  emergencyPhone      String?
  bloodGroup          String?
  address             String?
  avatarUrl           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                   User?                    @relation(fields: [userId], references: [id])
  department             Department?              @relation(fields: [departmentId], references: [id])
  attendances            Attendance[]
  leaveRequests          LeaveRequest[]
  payrollRecords         PayrollRecord[]
  workstationAllocations WorkstationAllocation[]
  faceBiometric          EmployeeFaceBiometric?

  @@map("employees")
  @@index([status])
  @@index([departmentId])
  @@index([workerCategory])
}

model Attendance {
  id               String    @id @default(uuid())
  employeeId       String
  punchDate        DateTime
  punchIn          DateTime?
  punchOut         DateTime?
  workHours        Float     @default(0)
  status           String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, LATE, ON_LEAVE, HOLIDAY
  shiftCode        String    @default("SHIFT_G")
  overtimeHours    Float     @default(0)
  overtimeApproved Boolean   @default(false)
  assignedBay      String?
  ppeCompliant     Boolean   @default(true)
  checkInNote      String?
  checkOutNote     String?
  location         String?   @default("MIDC Industrial Unit")
  deviceId         String?   // Biometric device that captured this punch
  devicePunchId    String?   // Original punch ID from biometric device
  source           String    @default("MANUAL") // MANUAL, DEVICE, API, KIOSK
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device           BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([employeeId, punchDate])
  @@map("attendances")
  @@index([employeeId])
  @@index([punchDate])
  @@index([status])
  @@index([deviceId])
  @@index([source])
}

// -------------------------------------------------------------
// 9. BIOMETRIC PUNCHING DEVICE INTEGRATION
// -------------------------------------------------------------
model BiometricDevice {
  id                    String   @id @default(uuid())
  deviceCode            String   @unique // TM-2026-0001
  deviceName            String   // Main Gate, Plant Entry, Assembly Bay
  deviceType            String   @default("FINGERPRINT_FACE") // FINGERPRINT, FACE, RFID, FINGERPRINT_FACE, CARD
  manufacturer          String   @default("TeamOffice") // TeamOffice, ZKTeco, Suprema, etc.
  model                 String?  // TM-700, UFace, etc.
  serialNumber          String?
  ipAddress             String?  // 192.168.1.100
  port                  Int      @default(4370) // Default ZK TCP port
  connectionType        String   @default("TCP_IP") // TCP_IP, HTTP, USB, SERIAL, CLOUD
  apiEndpoint           String?  // HTTP API base URL if connectionType=HTTP
  apiKey                String?  // API key for HTTP/Cloud devices
  apiSecret             String?  // API secret for HTTP/Cloud devices
  communicationKey      String?  // Device communication key (ZKLib etc.)
  isActive              Boolean  @default(true)
  lastSyncAt            DateTime?
  lastSyncStatus        String?  // SUCCESS, FAILED, PARTIAL, PENDING
  lastSyncRecordCount   Int      @default(0)
  lastSyncError         String?
  syncIntervalMinutes   Int      @default(15) // Auto-sync interval
  autoSyncEnabled       Boolean  @default(true)
  timezone              String   @default("Asia/Kolkata")
  location              String?  // Plant location description
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  syncLogs              DeviceSyncLog[]
  attendances           Attendance[]

  @@map("biometric_devices")
  @@index([ipAddress])
  @@index([isActive])
  @@index([connectionType])
}

model DeviceSyncLog {
  id             String   @id @default(uuid())
  deviceId       String
  deviceCode     String   // Denormalized for quick lookup
  syncType       String   // MANUAL, AUTO, WEBHOOK
  syncStatus     String   // SUCCESS, FAILED, PARTIAL
  recordsFetched Int      @default(0)
  recordsInserted Int     @default(0)
  recordsSkipped Int      @default(0)
  recordsUpdated Int      @default(0)
  errorMessage   String?
  errorDetails   String?  // JSON stack trace or error details
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  durationMs     Int?
  createdAt      DateTime @default(now())

  device         BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_sync_logs")
  @@index([deviceId])
  @@index([syncStatus])
  @@index([startedAt])
}

model WorkstationAllocation {
  id             String   @id @default(uuid())
  allocationDate DateTime @default(now())
  employeeId     String
  bayCode        String   // BAY_1_FABRICATION, BAY_2_BUSBAR, BAY_3_MOUNTING, BAY_4_WIRING, BAY_5_FAT_TESTING, BAY_6_DISPATCH
  panelCode      String?  // Links to panel job e.g. PANEL-2026-0001
  shiftCode      String   @default("SHIFT_G")
  targetHours    Float    @default(8.0)
  actualHours    Float    @default(8.0)
  status         String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, REALLOCATED
  supervisorNote String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("workstation_allocations")
}

model LeaveRequest {
  id           String   @id @default(uuid())
  leaveCode    String   @unique // LV-2026-0001
  employeeId   String
  leaveType    String   // CASUAL, SICK, EARNED, UNPAID, MATERNITY, PATERNITY
  startDate    DateTime
  endDate      DateTime
  daysCount    Float    @default(1)
  reason       String
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy   String?
  decisionNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

model PayrollRecord {
  id                  String    @id @default(uuid())
  slipNumber          String    @unique // PAY-2026-10-001
  employeeId          String
  month               String    // October 2026
  year                Int       @default(2026)
  monthNumber         Int       @default(10)
  workingDays         Int       @default(26)
  presentDays         Float     @default(26)
  basicSalary         Float     @default(0)
  hraAllowance        Float     @default(0)
  specialAllowance    Float     @default(0)
  overtimeHours       Float     @default(0)
  overtimePay         Float     @default(0)
  shiftAllowance      Float     @default(0)
  productionIncentive Float     @default(0)
  grossPay            Float     @default(0)
  pfDeduction         Float     @default(0)
  taxDeduction        Float     @default(0)
  esiDeduction        Float     @default(0)
  totalDeductions     Float     @default(0)
  netPay              Float     @default(0)
  paymentStatus       String    @default("PAID") // PENDING, PROCESSING, PAID
  paymentDate         DateTime?
  paymentMode         String    @default("NEFT/RTGS")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("payroll_records")
}

model SafetyIncident {
  id           String   @id @default(uuid())
  incidentCode String   @unique // INC-2026-001
  reportDate   DateTime @default(now())
  incidentType String   // NEAR_MISS, ELECTRICAL_ARC_FLASH, PPE_NON_COMPLIANCE, MINOR_CUT
  severity     String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  locationBay  String   // BAY_2_BUSBAR, BAY_5_FAT_TESTING, etc.
  employeeId   String?
  description  String
  actionTaken  String?
  status       String   @default("RESOLVED") // REPORTED, UNDER_INVESTIGATION, RESOLVED
  reportedBy   String?
  createdAt    DateTime @default(now())

  @@map("safety_incidents")
}

// -------------------------------------------------------------
// 12. BIOMETRIC FACE AUTHENTICATION & SECURITY
// -------------------------------------------------------------

model EmployeeFaceBiometric {
  id                  String    @id @default(uuid())
  employeeId          String?   @unique
  userId              String?   @unique
  encryptedEmbedding  String    // AES-256-GCM encrypted biometric vector JSON
  embeddingIv         String    // Initialization Vector (Hex)
  embeddingAuthTag    String    // GCM authentication tag (Hex)
  embeddingVersion    String    @default("v1.0")
  faceModel           String    @default("ssd-mobilenetv1-128d")
  passportPhotoPath   String?
  enrollmentPhotoPath String?
  isActive            Boolean   @default(true)
  enrolledAt          DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  employee            Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user                User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_face_biometrics")
}

model FaceAuthSetting {
  id                   String   @id @default(uuid())
  isEnabled            Boolean  @default(true)
  matchThreshold       Float    @default(0.55) // Euclidean distance threshold (lower = stricter)
  maxFailedAttempts    Int      @default(3)
  lockoutMinutes       Int      @default(15)
  livenessCheckEnabled Boolean  @default(true)
  enforceForRoles      String   @default("ALL") // ALL, ROLE_ADMIN, ROLE_HR, ROLE_EMPLOYEE
  updatedAt            DateTime @updatedAt

  @@map("face_auth_settings")
}

// -------------------------------------------------------------
// 13. SAARK PRODUCT SECTOR & TECHNICAL SPECIFICATIONS (38 FIELDS)
// -------------------------------------------------------------

model SaarkProductSector {
  id                          String   @id @default(uuid())
  // SECTION 1: Basic Identity & Description
  productSector               String   // Booster Pump Control Panel, STP Panel, Water Meter, BMS, Other, etc.
  productName                 String   // Product Name / Title
  skuModelNumber              String   @unique // SKU / Model Number (e.g. SAARK-BP-200, VCDA01)
  productCategory             String?  // Control Panel, Pump, Water Treatment, Water Metering, Automation, Other
  shortDescriptionFile        String?  // File path or summary description
  detailedDescriptionFile     String?  // Technical document path or full description
  targetApplicationsFile      String?  // Target applications document path

  // SECTION 2: Electrical & Power Specifications
  inputVoltage                String?  // 230V 1-Phase, 415V 3-Phase, 110V
  ratedFrequency              String?  // 50 Hz, 60 Hz, 50/60 Hz Dual
  minPowerRating              Float?   // e.g. 0.5, 3.0, 5.0
  maxPowerRating              Float?   // e.g. 10.0, 20.0, 30.0
  powerRatingUnit             String?  @default("HP") // HP, kW
  starterDriveType            String?  // DOL, Star-Delta, Integrated VFD, Soft Starter
  enclosureIpRating           String?  // IP54, IP55, IP65, NEMA 4X

  // SECTION 3: Pump Configuration & Control Parameters
  pumpSupportCapacity         String?  // 1 Pump, 2 Pumps [1W+1S], 3 Pumps, 4+ Multi-Cascade
  controlModes                String?  // Multi-checklist: Constant Pressure; Auto-Alternation; Duty/Assist/Standby; Manual Override
  pressureSensorCompatibility String?  // Multi-checklist: 4-20 mA; 0-10V; RS-485 Digital; Pressure Switch
  minPressure                 Float?   // e.g. 0.5, 1.0
  maxPressure                 Float?   // e.g. 6.0, 16.0
  pressureUnit                String?  @default("bar") // bar, PSI
  levelSensorInputs           String?  // Multi-checklist: Float Switch; Ultrasonic; Conductive Probes; Dry Run Float

  // SECTION 4: Smart Features, Display & Connectivity
  userInterfaceDisplay        String?  // Touchscreen HMI, Multi-line LCD, 7-Segment LED, Indicator LEDs
  communicationProtocols      String?  // Multi-checklist: RS-485 Modbus RTU; Modbus TCP/IP; BACnet; Ethernet
  iotCloudFeatures            String?  // Multi-checklist: GSM/4G Remote Telemetry; Wi-Fi Dashboard; Mobile App Support; SMS Alerts
  dataLogging                 String?  // Multi-checklist: Historical Fault Log; Run-Hour Meter; Pressure Trends

  // SECTION 5: Protections & Alarms
  electricalProtections       String?  // Multi-checklist: Overload; Under/Over-Voltage; Phase Failure; Phase Reversal; Short Circuit
  hydraulicProtections        String?  // Multi-checklist: Dry Run Protection (Auto-Reset); High/Low Pressure Cutoff; Pipe Burst / Leakage Detection; Anti-Seize Cycling

  // SECTION 6: Media, Documents & Compliance
  productImages               String?  // Pipe-delimited file paths (e.g. img1.png | img2.png)
  datasheetManual             String?  // Single PDF document path
  wiringSld                   String?  // Single Line Diagram path
  certifications              String?  // Multi-checklist: CE; RoHS; ISO 9001; CPRI Approved

  // SECTION 7: Promotional Material & Operational Videos
  promotionalVideo            String?  // Video file path (.mp4, .avi, etc.)
  photoName                   String?  // Photo caption / title
  photoDescription            String?  // Physical enclosure / internal layout notes
  photoAttachment             String?  // High-res image file path
  settingVideoType            String?  // Installation / Setup, Configuration, Commissioning, Operation, Troubleshooting, Other
  settingVideoDetails         String?  // Parameter setup notes or drive configuration steps
  settingVideoAttachment      String?  // Video guide file path

  // Status & Metadata
  status                      String   @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  createdByUserId             String?
  createdByUserEmail          String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("saark_product_sectors")
  @@index([productSector])
  @@index([skuModelNumber])
  @@index([productCategory])
  @@index([status])
}

model ProductSector {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_sectors")
}

model PromotionMaterial {
  id            String   @id @default(uuid())
  sector        String
  title         String
  materialType  String   // YouTube Video, Instagram Reel, Instagram Photo, Product Photo, etc.
  campaignName  String?
  platform      String   @default("YouTube")
  publishLink   String?
  attachmentUrl String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("promotion_materials")
  @@index([sector])
}

// -------------------------------------------------------------
// 22. B2B TRADING & WHITE-LABEL MARKETPLACE
// -------------------------------------------------------------

model B2bSupplier {
  id            String       @id @default(uuid())
  supplierCode  String?      @unique
  name          String
  contactPerson String?
  country       String?
  moq           Int          @default(1)
  sampleCost    Float        @default(0)
  leadTime      Int          @default(0) // Days
  rating        Float        @default(5.0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  products      B2bProduct[]

  @@map("b2b_suppliers")
}

model B2bCategory {
  id              String   @id @default(uuid())
  primaryCategory String   // Domestic, Industrial, Commercial, Custom
  subCategory     String?
  internalTag     String?
  createdAt       DateTime @default(now())

  @@map("b2b_categories")
}

model B2bProduct {
  id               String       @id // Timestamp sequence identifier (e.g. 20260920203658) or UUID
  
  // Tab 1: Taxonomy & Identification
  primaryCategory  String       @default("Domestic")
  subCategory      String?
  internalTag      String?
  originalName     String
  originalModel    String
  rebrandedName    String
  rebrandedModel   String
  collection       String?
  description      String?
  
  // Tab 2: Supplier & Sourcing
  supplierId       String?
  supplier         B2bSupplier? @relation(fields: [supplierId], references: [id])
  moq              Int          @default(1)
  sampleCost       Float        @default(0)
  leadTime         Int          @default(0)
  rating           Float        @default(5.0)

  // Tab 3: Technical Specs & Variants
  material         String?
  dimensions       String?
  weight           Float?
  hsCode           String?

  // Tab 4: White-Labeling & Branding
  logoPath         String?
  insertCardPath   String?
  pkgDims          String?
  printingSpecs    String?
  barcodePlacement String?
  brandCopy        String?
  seoTitle         String?
  seoMeta          String?

  // Tab 5: Financials & Margin
  baseCost         Float        @default(0)
  brandingFee      Float        @default(0)
  sampleShipping   Float        @default(0) // Packaging cost per unit
  freightPerUnit   Float        @default(0)
  landedCost       Float        @default(0)
  retailPrice      Float        @default(0)
  marginPct        Float        @default(0)
  stock            Int          @default(0)

  // Status & Timestamps
  status           String       @default("Draft") // Draft, published, Archived
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  variants         B2bVariant[]
  documents        B2bMedia[]

  @@map("b2b_products")
  @@index([status])
  @@index([primaryCategory])
  @@index([rebrandedName])
}

model B2bVariant {
  id          String     @id @default(uuid())
  productId   String
  product     B2bProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String
  color       String?
  size        String?
  packageType String?
  baseCost    Float      @default(0)
  retailPrice Float      @default(0)
  createdAt   DateTime   @default(now())

  @@map("b2b_variants")
}

model B2bMedia {
  id          String     @id @default(uuid())
  productId   String
  product     B2bProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetType   String     // SPEC_SHEET, USER_MANUAL, CERTIFICATE, INVOICE, ARTWORK, IMAGE
  filePath    String
  fileName    String?
  description String?
  createdAt   DateTime   @default(now())

  @@map("b2b_media")
}

