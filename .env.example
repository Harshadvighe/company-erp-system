# Saark Exploration ERP - Monorepo Setup & Workspace Configuration

# Environment configuration file (.env) for Backend
# Rename to .env in app root or apps/backend/
PORT=3000
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# GSTIN Portal verification; keep the API key only in the backend environment
GSTIN_API_KEY=
GST_VERIFICATION_TOKEN_SECRET=

# Database Configuration (Current: SQLite, Future: PostgreSQL)
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:../../storage/saark_erp.db"

# Storage Configuration (Current: local, Future: s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_PATH=../../storage
S3_BUCKET=saark-erp-documents
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Company Metadata
COMPANY_NAME="Saark Exploration Private Limited"
FINANCIAL_YEAR_DEFAULT="2026-27"
